{
  "name": "guildzero",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.22.3 || ^26.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs --backend",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "convex:codegen": "convex codegen",
    "auth:keys": "node scripts/auth-keys.mjs",
    "test:e2e": "playwright test",
    "test:near": "node scripts/verify-testnet.mjs",
    "check:client": "node scripts/check-client-boundary.mjs",
    "dev:frontend": "node scripts/dev.mjs --frontend"
  },
  "dependencies": {
    "@convex-dev/auth": "2.0.0",
    "@convex-dev/rate-limiter": "0.4.3",
    "@radix-ui/react-slot": "1.5.0",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.50.0",
    "lucide-react": "1.72.0",
    "near-api-js": "7.5.3",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "password-hash-wasm": "0.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "0.0.71",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite-plugin-wasm-module": "0.0.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module",
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild@0.27.0": true
  }
