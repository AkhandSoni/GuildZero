# Convex writes actual values to ignored .env.local on first `npm run dev`.
# These are placeholders; do not overwrite generated .env.local with this file.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# Auth 2 uses deployment-managed signing; no JWT_PRIVATE_KEY/JWKS setup is required.
# Never add JWT_PRIVATE_KEY, passwords, or Convex admin credentials here.
# NEAR signing configuration: set server-side ONLY in approved secret manager, never NEXT_PUBLIC_
# NEAR_NETWORK=testnet
# NEAR_OPERATOR_ACCOUNT_ID=
# NEAR_PRIVATE_KEY=(do not populate in committed files)
# NEAR_AGENT_RECIPIENTS_JSON={}
# NEAR_SETTLEMENT_ENABLED=false
# Backend-only optional private seller overrides; never NEXT_PUBLIC_:
# AGENT_PRIVATE_FLOORS_JSON={}
# Optional operator quotas. OFF by default for the hackathon demo.
# Set this true only when you want cumulative limits and account approval.
# NEAR_DEMO_ALLOWANCES_REQUIRED=true
# Server-only cumulative permissions (not faucet credits):
# Keys are authenticated Convex users IDs; signup never adds an entry.
# NEAR_DEMO_ALLOWANCES_JSON={"<approved-user-id>":"1000000000000000000000000"}
# NEAR_DEMO_OPERATOR_LIMIT_YOCTO=1000000000000000000000000
